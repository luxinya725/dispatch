# 复制为 .env 后填入真实值；部署到 HF Spaces 时改用 Settings → Secrets 注入。

# ── 模型（DeepSeek 的 Anthropic 兼容接口）────────────────────────────────
ANTHROPIC_API_KEY=your_deepseek_api_key_here
ANTHROPIC_MODEL=deepseek-chat
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── 应用 ────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis（工作记忆）─────────────────────────────────────────────────────
# 本地：redis://localhost:6379/0
# 云端可用 Upstash 免费层，或留空走内存降级
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB（向量库）────────────────────────────────────────────────────
# 未启动独立服务时自动降级为内嵌模式
CHROMA_HOST=localhost
CHROMA_PORT=8099
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
